{
  "name": "token-recovery-notifier",
  "version": "0.1.0",
  "description": "A resident Windows app that notifies you via toast notification when the Claude Code CLI rate limit resets",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "package": "node scripts/package-portable.js",
    "uninstall": "node dist/uninstall.js"
  },
  "dependencies": {
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/node-notifier": "^8.0.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
